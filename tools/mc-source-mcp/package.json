{
  "name": "@local/mc-source",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minecraft Source Bridge: indexes decompiled Forge 1.12.2 Minecraft/Forge sources and connects IntelliJ IDEA's MCP server.",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "server.js",
    "idea-bridge.js",
    "idea-tools.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
